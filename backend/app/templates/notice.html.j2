<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ n.id }} {{ n.kind }} · {{ case.ref }}</title>
<style>
body{font:14px/1.55 system-ui,"Nirmala UI","Noto Sans Malayalam",sans-serif;margin:28px;color:#000;max-width:820px}
h1{font-size:19px;margin-bottom:4px}table{border-collapse:collapse;width:100%;margin:10px 0}
th,td{border:1px solid #999;padding:5px 7px;text-align:left;vertical-align:top}th{width:26%;background:#f2f2f2}
.mono{font-family:Consolas,monospace;font-size:11px;word-break:break-all}.body{white-space:pre-wrap;border:1px solid #999;padding:10px}
.page{page-break-after:always}.draft{border:2px solid #000;padding:6px 10px;font-weight:700;margin:8px 0}@media print{button{display:none}}
</style></head><body>
{% for r in n.recipients %}
<div class="page">
<p>{{ station }}</p>
{% if draft %}<p class="draft">DRAFT: not approved by the SHO. Do not dispatch.</p>{% endif %}
<h1>{{ n.kind }} · {{ n.id }}</h1>
<table>
<tr><th>To</th><td>Station House Officer, {{ r.name }} Police Station{% if r.link %}<br><small>{{ r.link }}</small>{% endif %}</td></tr>
<tr><th>Reference</th><td>TRACE case {{ case.ref }}{% if r.pin %} · area PIN {{ r.pin }}{% endif %}</td></tr>
<tr><th>Subject</th><td>{{ n.subject }}</td></tr>
<tr><th>Prepared by</th><td>{{ n.created_by }} ({{ n.created_role|upper }}), {{ sent_at }}</td></tr>
<tr><th>Approved by</th><td>{% if approved %}{{ approved.by }} (SHO), {{ approved.at }}{% else %}Not approved{% endif %}</td></tr>
</table>
<div class="body">{{ n.body }}</div>
<p class="mono">Notice hash (SHA-256): {{ n.sha256 }} · recorded in the case custody chain</p>
<p style="font-size:12px">Recipients chosen and message confirmed by the officer, and approved by the SHO, named above. TRACE recommended stations; it did not choose them or send this notice.</p>
</div>
{% endfor %}
<button onclick="print()">Print / save as PDF</button>
</body></html>
