<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>TRACE Draft FIR — {{ case.id }}</title>
<style>
  body { font-family: "Noto Sans Malayalam", "Noto Sans", Arial, sans-serif; margin: 2rem; color: #111; }
  h1 { font-size: 1.4rem; }
  h2 { font-size: 1.1rem; margin-top: 2rem; border-bottom: 1px solid #ccc; padding-bottom: 0.25rem; }
  .meta { color: #555; font-size: 0.9rem; }
  .malayalam { font-style: normal; color: #333; background: #f7f7f7; padding: 0.5rem; }
  .unsupported { color: #b00; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  th, td { border: 1px solid #ccc; padding: 0.4rem; text-align: left; font-size: 0.9rem; }
  .advisory { color: #555; font-size: 0.85rem; }
  .qr { margin-top: 2rem; text-align: center; }
  @media print { body { margin: 0.5in; } }
</style>
</head>
<body>
  <h1>Draft First Information Report — TRACE</h1>
  <p class="meta">Case ID: {{ case.id }} · Complainant: {{ case.complainant_name }} · Location: {{ case.location or "Not recorded" }}</p>
  <p class="meta">Status: {{ case.status }} · Draft version: {{ draft.version if draft else "—" }}</p>

  <h2>Narrative (English)</h2>
  {% for sentence in (draft.sentences if draft else []) %}
    <p>{{ sentence.sentence }}{% if not sentence.supported %} <span class="unsupported">[Unsupported — needs officer review]</span>{% endif %}</p>
  {% else %}
    <p>No draft narrative generated yet.</p>
  {% endfor %}

  <h2>Original Malayalam Narration</h2>
  {% for narration in narrations %}
    <p class="malayalam">{{ narration.malayalam_text }}</p>
  {% else %}
    <p>No narration audio was uploaded for this case.</p>
  {% endfor %}

  <h2>Evidence Manifest</h2>
  <table>
    <tr><th>File</th><th>Type</th><th>SHA-256</th><th>Screening</th><th>Metadata conflict</th></tr>
    {% for file in files %}
    <tr>
      <td>{{ file.name }}</td>
      <td>{{ file.kind or "—" }}</td>
      <td style="font-family: monospace; font-size: 0.75rem;">{{ file.sha256 or "rejected" }}</td>
      <td>{{ file.screening.label if file.screening else "Not screened" }}</td>
      <td>{{ file.metadata.conflict if file.metadata and file.metadata.conflict else "None recorded" }}</td>
    </tr>
    {% endfor %}
  </table>

  <h2>Advisory Legal Sections (SHO-accepted)</h2>
  <p class="advisory">Advisory only — the officer files, not the AI. Section numbers are advisory until verified by a legal mentor.</p>
  <table>
    <tr><th>Section</th><th>Title</th><th>Ingredients</th></tr>
    {% for s in bns_suggestions %}
    <tr>
      <td>{{ s.section }}</td>
      <td>{{ s.title }}</td>
      <td>{{ s.ingredients | join("; ") }}</td>
    </tr>
    {% else %}
    <tr><td colspan="3">No sections accepted yet.</td></tr>
    {% endfor %}
  </table>

  <div class="qr">
    <img src="data:image/png;base64,{{ qr_base64 }}" width="160" height="160" alt="Verification QR code">
    <p class="meta">Head hash: {{ head_hash }}</p>
    <p class="meta">Scan to verify this export against the station's custody chain.</p>
  </div>
</body>
</html>
